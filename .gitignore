# meson subprojects: our wrap files and the glib patches
# (subprojects/packagefiles) are tracked. Everything else (downloads, source
# extractions, redirect stubs) is generated by meson.
/subprojects/packagecache/
/subprojects/.wraplock
/subprojects/glib-2.*/
/subprojects/gvdb*/
/subprojects/libffi-*/
/subprojects/orc/
/subprojects/pcre2-*/
/subprojects/proxy-libintl-*/
/subprojects/zlib-*/
/subprojects/gstreamer-full/
/subprojects/gstreamer-1.*/
/subprojects/gst-plugins-base-1.*/
/subprojects/orc-0.*/
/subprojects/*.wrap.*
/subprojects/gvdb.wrap
/subprojects/libffi.wrap
/subprojects/orc.wrap
/subprojects/pcre2.wrap
/subprojects/proxy-libintl.wrap
/subprojects/zlib.wrap
